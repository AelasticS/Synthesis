{
  "name": "@synthesis/cli",
  "description": "Synthesis model-driven engineering CLI",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": "./lib/index.js",
  "bin": {
    "synth": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json",
    "/npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "heft build --clean",
    "test": "heft test --clean"
  },
  "oclif": {
    "bin": "synth",
    "dirname": "synth",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-not-found",
      "@oclif/plugin-autocomplete"
    ],
    "topics": {
      "ns": {
        "description": "Manage namespaces (folders under models/)."
      },
      "model": {
        "description": "Manage model instances in the workspace."
      },
      "tx": {
        "description": "Install, inspect, and author transformations."
      },
      "config": {
        "description": "Manage variability configurations."
      },
      "workspace": {
        "description": "Inspect or switch the active workspace."
      }
    },
    "additionalHelpFlags": ["-h"]
  },
  "dependencies": {
    "@oclif/core": "~4.11.2",
    "@oclif/plugin-help": "~6.2.48",
    "@oclif/plugin-plugins": "~5.4.67",
    "@oclif/plugin-not-found": "~3.2.85",
    "@oclif/plugin-autocomplete": "~3.2.40"
  },
  "devDependencies": {
    "@rushstack/eslint-config": "~4.6.4",
    "eslint": "~10.0.2",
    "@rushstack/heft": "~1.2.6",
    "@rushstack/heft-jest-plugin": "~1.2.6",
    "@rushstack/heft-typescript-plugin": "~1.3.1",
    "@types/node": "~25.3.3",
    "@types/heft-jest": "~1.0.6",
    "typescript": "~5.9.3",
    "oclif": "~4.23.0",
    "@oclif/test": "~4.1.18"
  }
}
