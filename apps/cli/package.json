{
  "name": "@aelastics/synthesis-cli",
  "description": "Synthesis model-driven engineering CLI",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": "./lib/index.js",
  "bin": {
    "synth": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json",
    "/npm-shrinkwrap.json",
    "/scripts/completion"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "heft build --clean",
    "test": "node --experimental-vm-modules node_modules/@rushstack/heft/lib/start.js test --clean",
    "start": "node bin/run.js",
    "smoke": "bash scripts/smoke-test.sh",
    "pack:tarballs": "node config/pack-tarballs.mjs",
    "smoke:bundle": "node config/smoke-bundle.mjs",
    "pack:clean": "rm -rf dist tmp vendor"
  },
  "oclif": {
    "bin": "synth",
    "dirname": "synth",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-not-found",
      "@oclif/plugin-autocomplete"
    ],
    "topics": {
      "namespace": {
        "description": "Manage namespaces (folders under models/)."
      },
      "ns": {
        "description": "Alias of 'namespace'.",
        "hidden": true
      },
      "model": {
        "description": "Manage model instances in the workspace."
      },
      "transformation": {
        "description": "Install, inspect, author, and run transformations."
      },
      "tx": {
        "description": "Alias of 'transformation'.",
        "hidden": true
      },
      "config": {
        "description": "Manage variability configurations."
      },
      "pipeline": {
        "description": "Manage and run saved pipelines (named transformation chains)."
      },
      "pl": {
        "description": "Alias of 'pipeline'.",
        "hidden": true
      },
      "workspace": {
        "description": "Inspect or switch the active workspace."
      }
    },
    "additionalHelpFlags": ["-h"]
  },
  "dependencies": {
    "@inquirer/prompts": "~7.10.1",
    "@oclif/core": "~4.11.2",
    "@oclif/plugin-help": "~6.2.48",
    "@oclif/plugin-plugins": "~5.4.67",
    "@oclif/plugin-not-found": "~3.2.85",
    "@oclif/plugin-autocomplete": "~3.2.40",
    "@aelastics/synthesis": "workspace:*",
    "@aelastics/types": "workspace:*",
    "@aelastics/result": "workspace:*",
    "esbuild": "~0.25.0"
  },
  "devDependencies": {
    "eer-metamodel": "workspace:*",
    "relational-metamodel": "workspace:*",
    "rel-tutorial-metamodel": "workspace:*",
    "@rushstack/eslint-config": "~4.6.4",
    "eslint": "~10.0.2",
    "@rushstack/heft": "~1.2.6",
    "@rushstack/heft-jest-plugin": "~1.2.6",
    "@rushstack/heft-typescript-plugin": "~1.3.1",
    "@types/node": "~25.3.3",
    "@types/heft-jest": "~1.0.6",
    "typescript": "~5.9.3",
    "oclif": "~4.23.0",
    "@oclif/test": "~4.1.18"
  }
}
