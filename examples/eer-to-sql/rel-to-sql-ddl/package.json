{
  "name": "rel-to-sql-ddl",
  "version": "0.1.0",
  "private": true,
  "description": "Configuration-based Synthesis m2t transformation: relational schema to SQL DDL text",
  "author": "Sinisa Neskovic",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/transformation.js",
  "exports": {
    ".": "./dist/transformation.js",
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    }
  },
  "typesVersions": {
    "*": {
      "presets": ["dist/presets.d.ts"]
    }
  },
  "files": [
    "dist",
    "synth.json",
    "presets"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node ../../smoke.mjs && node scripts/verify.mjs"
  },
  "dependencies": {
    "@aelastics/synthesis": "workspace:*",
    "relational-metamodel": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@aelastics/synthesis-cli": "workspace:*"
  }
}
