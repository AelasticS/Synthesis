{
  "name": "@aelastics/synthesis",
  "version": "0.1.0",
  "description": "The Synthesis model transformation library: JSX authoring runtime, model store, model-to-model and model-to-text engines, and configuration-based variability",
  "author": "Sinisa Neskovic",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "heft build --clean",
    "test": "heft test --clean"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./jsx-runtime": {
      "types": "./lib/jsx-runtime/index.d.ts",
      "default": "./lib/jsx-runtime/index.js"
    },
    "./jsx-runtime/*": {
      "types": "./lib/jsx-runtime/*.d.ts",
      "default": "./lib/jsx-runtime/*.js"
    },
    "./metamodel-core": {
      "types": "./lib/metamodel-core/index.d.ts",
      "default": "./lib/metamodel-core/index.js"
    },
    "./metamodel-core/*": {
      "types": "./lib/metamodel-core/*.d.ts",
      "default": "./lib/metamodel-core/*.js"
    },
    "./engine": {
      "types": "./lib/engine/index.d.ts",
      "default": "./lib/engine/index.js"
    },
    "./engine/*": {
      "types": "./lib/engine/*.d.ts",
      "default": "./lib/engine/*.js"
    },
    "./decision-framework": {
      "types": "./lib/decision-framework/index.d.ts",
      "default": "./lib/decision-framework/index.js"
    },
    "./decision-framework/*": {
      "types": "./lib/decision-framework/*.d.ts",
      "default": "./lib/decision-framework/*.js"
    },
    "./metamodels/types": {
      "types": "./lib/metamodels/types/index.d.ts",
      "default": "./lib/metamodels/types/index.js"
    },
    "./metamodels/types/model": {
      "types": "./lib/metamodels/types/types-meta.model.d.ts",
      "default": "./lib/metamodels/types/types-meta.model.js"
    },
    "./metamodels/types/components": {
      "types": "./lib/metamodels/types/types-components.d.ts",
      "default": "./lib/metamodels/types/types-components.js"
    },
    "./metamodels/types/predefined-model": {
      "types": "./lib/metamodels/types/predefined-model.d.ts",
      "default": "./lib/metamodels/types/predefined-model.js"
    },
    "./metamodels/types/predefined-types": {
      "types": "./lib/metamodels/types/predefined-types.d.ts",
      "default": "./lib/metamodels/types/predefined-types.js"
    }
  },
  "typesVersions": {
    "*": {
      "jsx-runtime": ["lib/jsx-runtime/index.d.ts"],
      "jsx-runtime/*": ["lib/jsx-runtime/*.d.ts"],
      "metamodel-core": ["lib/metamodel-core/index.d.ts"],
      "metamodel-core/*": ["lib/metamodel-core/*.d.ts"],
      "engine": ["lib/engine/index.d.ts"],
      "engine/*": ["lib/engine/*.d.ts"],
      "decision-framework": ["lib/decision-framework/index.d.ts"],
      "decision-framework/*": ["lib/decision-framework/*.d.ts"],
      "metamodels/types": ["lib/metamodels/types/index.d.ts"],
      "metamodels/types/model": ["lib/metamodels/types/types-meta.model.d.ts"],
      "metamodels/types/components": ["lib/metamodels/types/types-components.d.ts"],
      "metamodels/types/predefined-model": ["lib/metamodels/types/predefined-model.d.ts"],
      "metamodels/types/predefined-types": ["lib/metamodels/types/predefined-types.d.ts"]
    }
  },
  "dependencies": {
    "@aelastics/result": "workspace:*",
    "@aelastics/types": "workspace:*",
    "@aelastics/store": "workspace:*"
  },
  "devDependencies": {
    "@rushstack/eslint-config": "~4.6.4",
    "eslint": "~10.0.2",
    "@rushstack/heft": "~1.2.6",
    "@rushstack/heft-jest-plugin": "~1.2.6",
    "@rushstack/heft-typescript-plugin": "~1.3.1",
    "@types/node": "~25.3.3",
    "@types/heft-jest": "~1.0.6",
    "tslib": "^2.6.0",
    "typescript": "~5.9.3"
  }
}
