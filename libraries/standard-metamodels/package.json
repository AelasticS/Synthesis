{
  "name": "@synthesis/standard-metamodels",
  "author": "Sinisa Neskovic",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "heft build --clean",
    "test": "heft test --clean"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./eer": {
      "types": "./lib/eer/index.d.ts",
      "default": "./lib/eer/index.js"
    },
    "./eer/model": {
      "types": "./lib/eer/EER.meta.model.type.d.ts",
      "default": "./lib/eer/EER.meta.model.type.js"
    },
    "./rel-tutorial": {
      "types": "./lib/rel-tutorial/index.d.ts",
      "default": "./lib/rel-tutorial/index.js"
    },
    "./rel-tutorial/model": {
      "types": "./lib/rel-tutorial/REL-tutorial.meta.model.type.d.ts",
      "default": "./lib/rel-tutorial/REL-tutorial.meta.model.type.js"
    },
    "./rel-tutorial/components": {
      "types": "./lib/rel-tutorial/REL-tutorial-components.d.ts",
      "default": "./lib/rel-tutorial/REL-tutorial-components.js"
    },
    "./eer-tutorial/basic": {
      "types": "./lib/eer-tutorial/basic/index.d.ts",
      "default": "./lib/eer-tutorial/basic/index.js"
    },
    "./eer-tutorial/basic/model": {
      "types": "./lib/eer-tutorial/basic/EER-basic.meta.model.type.d.ts",
      "default": "./lib/eer-tutorial/basic/EER-basic.meta.model.type.js"
    },
    "./eer-tutorial/basic/components": {
      "types": "./lib/eer-tutorial/basic/EER-basic-components.d.ts",
      "default": "./lib/eer-tutorial/basic/EER-basic-components.js"
    },
    "./eer-tutorial/advanced": {
      "types": "./lib/eer-tutorial/advanced/index.d.ts",
      "default": "./lib/eer-tutorial/advanced/index.js"
    },
    "./eer-tutorial/advanced/model": {
      "types": "./lib/eer-tutorial/advanced/EER-advanced.meta.model.type.d.ts",
      "default": "./lib/eer-tutorial/advanced/EER-advanced.meta.model.type.js"
    },
    "./eer-tutorial/advanced/components": {
      "types": "./lib/eer-tutorial/advanced/EER-advanced-components.d.ts",
      "default": "./lib/eer-tutorial/advanced/EER-advanced-components.js"
    },
    "./relational": {
      "types": "./lib/relational/index.d.ts",
      "default": "./lib/relational/index.js"
    },
    "./relational/model": {
      "types": "./lib/relational/REL.meta.model.type.legacy.d.ts",
      "default": "./lib/relational/REL.meta.model.type.legacy.js"
    },
    "./relational/model-legacy": {
      "types": "./lib/relational/REL.meta.model.type.legacy.d.ts",
      "default": "./lib/relational/REL.meta.model.type.legacy.js"
    },
    "./relational/components-legacy": {
      "types": "./lib/relational/REL-components.legacy.d.ts",
      "default": "./lib/relational/REL-components.legacy.js"
    }
  },
  "typesVersions": {
    "*": {
      "eer": ["lib/eer/index.d.ts"],
      "eer/model": ["lib/eer/EER.meta.model.type.d.ts"],
      "relational": ["lib/relational/index.d.ts"],
      "relational/model": ["lib/relational/REL.meta.model.type.legacy.d.ts"],
      "relational/model-legacy": ["lib/relational/REL.meta.model.type.legacy.d.ts"],
      "relational/components-legacy": ["lib/relational/REL-components.legacy.d.ts"]
    }
  },
  "dependencies": {
    "@aelastics/types": "workspace:*",
    "@aelastics/synthesis": "workspace:*"
  },
  "devDependencies": {
    "@rushstack/eslint-config": "~4.6.4",
    "eslint": "~10.0.2",
    "@rushstack/heft": "~1.2.6",
    "@rushstack/heft-jest-plugin": "~1.2.6",
    "@rushstack/heft-typescript-plugin": "~1.3.1",
    "@types/node": "~25.3.3",
    "@types/heft-jest": "~1.0.6",
    "tslib": "^2.6.0",
    "typescript": "~5.9.3"
  }
}
